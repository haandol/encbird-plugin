    {
      "name": "encbird_submit_quiz_result",
      "description": "Save actual answer, learner rating 1-4 and assistance for a pinned question revision.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quizId": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+={0,2}$"
          },
          "questionRevision": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-fA-F]+$"
          },
          "expressionId": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^(?:[A-Za-z0-9_-]+={0,2})?$"
          },
          "answer": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Learner-selected recall rating: 1 = Again (다시), 2 = Hard (어려움), 3 = Good (좋음), 4 = Easy (쉬움). Explain these choices and use the learner's explicit selection; never infer a rating."
          },
          "completed": {
            "type": "boolean",
            "const": true
          },
          "assistance": {
            "type": "string",
            "enum": [
              "none",
              "hint",
              "answer",
              "unknown"
            ]
          },
          "sourceHost": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "sourceSessionId": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          }
        },
        "required": [
          "quizId",
          "questionRevision",
          "answer",
          "rating",
          "completed",
          "assistance",
          "sourceHost",
          "sourceSessionId",
          "idempotencyKey"
        ],
        "additionalProperties": false
