    {
      "name": "encbird_accept_suggested_expression",
      "description": "Acknowledge an already registered NORMAL expression and close its version-pinned recommendation without charging.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "phraseHash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Exact selected candidate version. Explicit zero is allowed for an unchanged legacy candidate."
          },
          "registrationKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+(?![\\s\\S])",
            "description": "Exact key from the successful registration attempt (its original idempotencyKey); 1–128 printable ASCII bytes 0x21–0x7e, with no whitespace. Current AddExpressionResult does not echo the key."
          }
        },
        "required": [
          "phraseHash",
          "version",
          "registrationKey"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "phraseHash": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "const": "saved"
              }
            },
            "required": [
              "phraseHash",
              "version",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      }
