{
  "name": "encbird-plugin-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "EncBird",
  "type": "module",
  "workspaces": [
    "plugins/encbird"
  ],
  "scripts": {
    "build": "npm run build -w plugins/encbird",
    "typecheck": "npm run typecheck -w plugins/encbird",
    "test": "npm run test -w plugins/encbird",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check.mjs",
    "check:test": "node scripts/check.mjs test",
    "check:build": "node scripts/check.mjs build",
    "check:push": "node scripts/check.mjs push",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:eval": "node --test evals/tests/*.test.mjs",
    "validate:docs": "node scripts/validate-doc-links.mjs",
    "eval:skills": "node evals/run.mjs",
    "ci:protect": "node scripts/configure-main-protection.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:set": "node scripts/version.mjs set",
    "hooks:install": "node scripts/install-hooks.mjs",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/release-command.mjs check",
    "release:push": "node scripts/release-command.mjs push",
    "release:publish": "node scripts/release-command.mjs publish",
    "tag:push": "bash scripts/push-version.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
