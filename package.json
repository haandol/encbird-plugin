{
  "name": "encbird-plugin-workspace",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "EncBird",
  "type": "module",
  "workspaces": [
    "plugins/encbird"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run --cwd plugins/encbird build",
    "typecheck": "bun run --cwd plugins/encbird typecheck",
    "test": "bun run --cwd plugins/encbird test",
    "validate": "bun scripts/validate.mjs",
    "check": "bun scripts/check.mjs",
    "check:test": "bun scripts/check.mjs test",
    "check:build": "bun scripts/check.mjs build",
    "check:push": "bun scripts/check.mjs push",
    "test:runtime": "bun scripts/runtime-smoke.mjs",
    "test:eval": "bun test --timeout 60000 evals/tests/*.test.mjs",
    "validate:docs": "bun scripts/validate-doc-links.mjs",
    "audit:deps": "bun audit",
    "eval:skills": "bun evals/run.mjs",
    "ci:protect": "bun scripts/configure-main-protection.mjs",
    "version:check": "bun scripts/version.mjs check",
    "version:bump": "bun scripts/version.mjs bump",
    "version:set": "bun scripts/version.mjs set",
    "hooks:install": "bun scripts/install-hooks.mjs",
    "test:release": "bun test --timeout 60000 scripts/tests/*.test.mjs",
    "release:prepare": "bun scripts/prepare-release.mjs",
    "release:check": "bun scripts/release-command.mjs check",
    "release:push": "bun scripts/release-command.mjs push",
    "release:publish": "bun scripts/release-command.mjs publish",
    "tag:push": "bash scripts/push-version.sh"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
